{
  "manifest_version": 3,
  "name": "Red Marker Page",
  "version": "0.1.2",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8766/*", "http://127.0.0.1:4310/*", "file:///*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Red Marker Page" },
  "commands": {
    "toggle-annotate": { "description": "注釈モードを切り替える", "suggested_key": { "default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period" } },
    "copy-tab-id": { "description": "タブ ID をコピーする", "suggested_key": { "default": "Alt+Shift+I", "mac": "MacCtrl+Shift+C" } },
    "open-rmv-panel": { "description": "rmv のサイドパネル (返事の表示) を開く／閉じる", "suggested_key": { "default": "Ctrl+Shift+Comma", "mac": "Command+Shift+Comma" } }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
